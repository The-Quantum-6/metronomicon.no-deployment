POSTGRES_USER=postgres
POSTGRES_PASSWORD=${secrets.POSTGRES_PASSWORD}
POSTGRES_DB=db
DATABASE_URL=${secrets.POSTGRES_URL}
API_BASE_URL=/api
GOOGLE_SECRET=${secrets.GOOGLE_SECRET}
GOOGLE_CLIENT_ID=${secrets.GOOGLE_CLIENT_ID}
GOOGLE_REDIRECT_URI=${secrets.GOOGLE_REDIRECT_URI}

# --- Garage / S3 object storage ---
# Running the backend on the host (cargo run / cargo run --example garage_smoke),
# Garage is reachable on localhost. Inside docker compose use http://garage:3900.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=test-bucket
# Max accepted upload size in bytes for /files multipart requests.
UPLOAD_MAX_BYTES=10485760
# Must match the values in the root .env — Garage creates this key
# automatically on first start. Generate a unique keypair for your local dev
# environment; LOCAL-DEV-ONLY credentials; never reuse in production.
AWS_ACCESS_KEY_ID=GK__GENERATE_ME__
AWS_SECRET_ACCESS_KEY=__GENERATE_ME__
JWT_SECRET=${JWT_SECRET}
GARAGE_RPC_SECRET=${GARAGE_RPC_SECRET}

REFRESH_TOKEN_TTL_DAYS=${REFRESH_TOKEN_TTL_DAYS}
